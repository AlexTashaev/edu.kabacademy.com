{{!
    @template theme_kabacademy/donate_button

    Кнопка «Поддержать академию» в шапке (вариант «Б»). На телефоне — только сердце.

    Example context (json):
    {"url": "https://example.com/donate", "external": true}
}}
<div class="kab-donate-wrap d-flex align-items-center">
    <a class="kab-donate" href="{{url}}"{{#external}} target="_blank" rel="noopener"{{/external}}>
        <svg class="kab-donate-icon" width="18" height="17" viewBox="0 0 24 22" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M20.8 3.6a5.5 5.5 0 0 0-7.8 0L12 4.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 20.3l7.8-7.9 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        <span class="kab-donate-text">{{#str}} donate, theme_kabacademy {{/str}}</span>
    </a>
</div>
