{{!
    @template block_myoverview/progress-bar

    This template renders a visual progress bar with percentage text.

    Classes required for JS: none
    Data attributes required for JS: none

    Context variables required for this template:
    * progress - int - completion percentage (0-100)

    Example context (json):
    { "progress": 50 }
}}
<div class="dashboard-progress-bar">
    <span class="visually-hidden">
        {{#str}}aria:courseprogress, block_myoverview{{/str}}
    </span>
    <div class="progress" style="height: 8px; border-radius: 4px; background-color: #e9ecef;">
        <div class="progress-bar bg-primary" role="progressbar"
             style="width: {{progress}}%; border-radius: 4px;"
             aria-valuenow="{{progress}}"
             aria-valuemin="0"
             aria-valuemax="100">
        </div>
    </div>
    <div class="small text-muted mt-1">
        {{#str}}progresspercent, theme_kabacademy, {{progress}}{{/str}}
    </div>
</div>
