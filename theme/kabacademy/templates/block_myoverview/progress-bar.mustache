{{!
    @template block_myoverview/progress-bar

    This template renders a visual progress bar with percentage text.

    Classes required for JS: none
    Data attributes required for JS: none

    Context variables required for this template:
    * progress - int - completion percentage (0-100)

    Example context (json):
    { "progress": 50 }
}}
<div class="progress-bar-container">
    <span class="visually-hidden">
        {{#str}}aria:courseprogress, block_myoverview{{/str}}
    </span>
    <div class="progress" style="height: 8px;">
        <div class="progress-bar" role="progressbar"
             style="width: {{progress}}%"
             aria-valuenow="{{progress}}"
             aria-valuemin="0"
             aria-valuemax="100">
        </div>
    </div>
    <div class="progress-text">
        <span>{{#str}}completepercent, block_myoverview, {{progress}}{{/str}}</span>
    </div>
</div>
