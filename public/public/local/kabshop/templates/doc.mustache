{{!
    @template local_kabshop/doc

    Страница документа витрины (оферта, политика конфиденциальности). Текст —
    готовый HTML из каталога legal/ плагина.

    Example context (json):
    {"html": "<p>Текст документа</p>", "catalogurl": "#"}
}}
<div class="kabshop-doc">
    <div class="kabshop-doc-body">{{{html}}}</div>
    <p class="kabshop-back"><a href="{{catalogurl}}">← {{#str}} backtocatalog, local_kabshop {{/str}}</a></p>
</div>
