{{!
    @template local_kabshop/card

    Карточка товара в каталоге.

    Example context (json):
    {"id": 1, "name": "Классическая каббала", "summary": "15 уроков", "price": "Бесплатно",
     "free": true, "image": null, "url": "#", "external": false, "hidden": false}
}}
<article class="kabshop-card{{#hidden}} kabshop-card-hidden{{/hidden}}">
    <a class="kabshop-card-media" href="{{url}}" tabindex="-1" aria-hidden="true">
        {{#image}}<img src="{{image}}" alt="" loading="lazy">{{/image}}
        {{^image}}<span class="kabshop-card-placeholder"></span>{{/image}}
    </a>
    <div class="kabshop-card-body">
        <h3 class="kabshop-card-title"><a href="{{url}}">{{name}}</a></h3>
        {{#summary}}<p class="kabshop-card-summary">{{{summary}}}</p>{{/summary}}
        <div class="kabshop-card-footer">
            {{#price}}<span class="kabshop-price{{#free}} kabshop-price-free{{/free}}">{{price}}</span>{{/price}}
            <a class="btn btn-primary btn-sm kabshop-more" href="{{url}}">
                {{#external}}{{#str}} gotoexternal, local_kabshop {{/str}}{{/external}}
                {{^external}}{{#str}} more, local_kabshop {{/str}}{{/external}}
            </a>
        </div>
    </div>
</article>
