{{!
    @template local_kabshop/legal

    Юридический блок внизу каталога и страницы товара: продавец с реквизитами,
    контакты, ссылки на оферту и политику конфиденциальности. Виден без кликов —
    платёжные системы проверяют, что эти сведения есть на странице продажи.

    Example context (json):
    {"paylabel": "Оплата в рублях. Продавец:",
     "seller": "Некоммерческий фонд «Институт», ИНН 0000000000, ОГРН 0000000000000",
     "email": "support@example.com", "phone": "+7 (495) 0000000", "phonehref": "+74950000000",
     "offerurl": "#", "offerlabel": "Публичная оферта (для РФ)",
     "privacyurl": "#", "privacylabel": "Политика конфиденциальности"}
}}
<div class="kabshop-legal">
    <p class="kabshop-legal-seller"><span class="kabshop-legal-label">{{paylabel}}</span> {{seller}}</p>
    <p class="kabshop-legal-contacts">
        <span class="kabshop-legal-label">{{#str}} legal_contacts, local_kabshop {{/str}}</span>
        <a href="mailto:{{email}}">{{email}}</a>{{#phone}}, <a href="tel:{{phonehref}}">{{phone}}</a>{{/phone}}
    </p>
    <p class="kabshop-legal-links">
        <a href="{{offerurl}}">{{offerlabel}}</a>
        <a href="{{privacyurl}}">{{privacylabel}}</a>
    </p>
</div>
