{{!
    @template local_kabshop/product

    Страница товара.

    Example context (json):
    {"name": "Система мироздания", "summary": "Спецкурс", "description": "<p>Описание</p>",
     "price": "70,00 $", "free": false, "image": null, "paid": false, "nopayment": false,
     "canmanage": false, "editurl": "#", "catalogurl": "#",
     "action": {"href": "#", "label": "Войти и купить"}
    }
}}
<div class="kabshop-product">
    {{#paid}}
    <div class="alert alert-success">{{#str}} thankyou, local_kabshop {{/str}}</div>
    {{/paid}}
    <div class="kabshop-product-hero">
        <div class="kabshop-product-media">
            {{#image}}<img src="{{image}}" alt="">{{/image}}
            {{^image}}<span class="kabshop-card-placeholder"></span>{{/image}}
        </div>
        <div class="kabshop-product-buy">
            {{#summary}}<p class="kabshop-product-summary">{{{summary}}}</p>{{/summary}}
            {{#price}}<div class="kabshop-price kabshop-price-lg{{#free}} kabshop-price-free{{/free}}">{{price}}</div>{{/price}}
            {{#subinfo}}<div class="alert alert-info">{{subinfo}}</div>{{/subinfo}}
            {{#action}}
                {{#href}}<a class="btn btn-primary btn-lg" href="{{href}}">{{label}}</a>{{/href}}
                {{#post}}
                <form method="post" action="{{post}}">
                    <input type="hidden" name="id" value="{{id}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="btn btn-primary btn-lg">{{label}}</button>
                </form>
                {{/post}}
                {{#payment}}
                <button type="button" class="btn btn-primary btn-lg"
                        {{#autopay}}data-kabshop-autopay="1"{{/autopay}}
                        data-action="core_payment/triggerPayment"
                        data-component="{{component}}"
                        data-paymentarea="{{paymentarea}}"
                        data-itemid="{{itemid}}"
                        data-cost="{{cost}}"
                        data-successurl="{{successurl}}"
                        data-description="{{description}}">{{label}}</button>
                {{/payment}}
            {{/action}}
            {{#changeurl}}
            <div class="mt-2"><a href="{{changeurl}}">{{#str}} changeamount, local_kabshop {{/str}}</a></div>
            {{/changeurl}}
            {{#donateform}}
            <form method="post" action="{{url}}" class="kabshop-donate">
                <input type="hidden" name="id" value="{{id}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <fieldset>
                    <legend class="kabshop-donate-legend">{{#str}} chooseamount, local_kabshop {{/str}}</legend>
                    <div class="kabshop-presets">
                        {{#presets}}
                        <input type="radio" class="btn-check" name="preset" id="kabshop-preset-{{value}}" value="{{value}}" {{#checked}}checked{{/checked}}>
                        <label class="btn btn-outline-primary" for="kabshop-preset-{{value}}">{{label}}</label>
                        {{/presets}}
                    </div>
                    <label class="kabshop-custom-label" for="kabshop-custom">{{#str}} otheramount, local_kabshop {{/str}}</label>
                    <div class="input-group kabshop-custom">
                        <input type="number" class="form-control" id="kabshop-custom" name="customvalue" min="{{min}}" step="0.01" inputmode="decimal">
                        <span class="input-group-text">{{currency}}</span>
                    </div>
                </fieldset>
                <button type="submit" class="btn btn-primary btn-lg mt-3">{{#str}} continue {{/str}}</button>
            </form>
            {{/donateform}}
            {{#nopayment}}
            <div class="alert alert-warning mt-2">{{#str}} nopayment, local_kabshop {{/str}}</div>
            {{/nopayment}}
            {{#canmanage}}
            <div class="mt-3"><a href="{{editurl}}">{{#str}} editproduct, local_kabshop {{/str}}</a></div>
            {{/canmanage}}
        </div>
    </div>
    {{#description}}
    <div class="kabshop-product-description">{{{description}}}</div>
    {{/description}}
    <p class="mt-4"><a href="{{catalogurl}}">← {{#str}} backtocatalog, local_kabshop {{/str}}</a></p>
</div>
