<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="payment/gateway/kbb1/db" VERSION="20261021" COMMENT="XMLDB file for paygw_kbb1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="paygw_kbb1" COMMENT="Платежи через external_payments: от создания сессии до возврата">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="paymentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="payments.id после успешной оплаты"/>
        <FIELD NAME="component" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="paymentarea" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="accountid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="amount" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0" SEQUENCE="false" DECIMALS="2"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="3" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="method" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="emv|paypal"/>
        <FIELD NAME="userkey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="UserKey для сервиса"/>
        <FIELD NAME="goodkey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Секрет адреса успешного возврата"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending|paid|cancel|error"/>
        <FIELD NAME="txnid" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="transaction_id / ApprovalNo"/>
        <FIELD NAME="token" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Токен карты (EMV) или vault_token (PayPal) — для автосписаний"/>
        <FIELD NAME="authno" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="returnurl" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Куда вернуть при отмене/ошибке"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="paymentid" UNIQUE="false" FIELDS="paymentid"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
